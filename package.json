{
  "name": "avito-mcp-server",
  "version": "1.0.0",
  "description": "Cross-platform Model Context Protocol (MCP) server for Avito (Windows, macOS, Linux): search listings, view details, chat with sellers and negotiate deals",
  "main": "avito_server.mjs",
  "bin": {
    "avito-mcp-server": "./avito_server.mjs"
  },
  "type": "module",
  "scripts": {
    "start": "node avito_server.mjs",
    "login": "node login_avito.js",
    "cdp": "node scripts/run_cdp.mjs",
    "daemon:install": "node scripts/setup_daemon.mjs",
    "daemon:uninstall": "node scripts/uninstall_daemon.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "avito",
    "ai-agent",
    "automation",
    "playwright",
    "cross-platform"
  ],
  "author": "foorsee",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "playwright-core": "^1.40.0",
    "zod": "^3.22.0"
  }
}
